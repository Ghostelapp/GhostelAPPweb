MONGO_URL=mongodb://localhost:27017
DB_NAME=ghostel_web
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
FRONTEND_URL=https://ghostel.app
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=60

# App backend API used for shared user registration/login.
# Local app backend example:
GHOSTEL_API_URL=http://localhost:8000/api

# Optional: enables admin stats/users sync from the app backend.
GHOSTEL_ADMIN_EMAIL=
GHOSTEL_ADMIN_PASSWORD=

# Local/demo data only.
SEED_SAMPLE_DATA=false
